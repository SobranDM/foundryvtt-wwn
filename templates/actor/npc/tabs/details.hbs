{{!-- NPC Details: encounter prep, extra combat fields, save mods, notes. --}}
<section class="tab notes-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="wwn-form-stack">
    <div class="wwn-form-grid">
      <div class="wwn-form-panel">
        <div class="wwn-section-header">{{localize "WWN.category.details"}}</div>
        <div class="wwn-form-panel-fields">
          <div class="form-group">
            <label>{{localize "WWN.details.experience.award"}}</label>
            <div class="form-fields">
              <input type="number" name="system.details.xp" value="{{system.details.xp}}" data-dtype="Number" />
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "WWN.details.dungeonAppearing"}}</label>
            <div class="form-fields">
              <input type="text" name="system.details.appearing.d" value="{{system.details.appearing.d}}" />
              <a data-action="rollAppearing" data-which="d" title="{{localize 'WWN.details.dungeonAppearing'}}">
                <i class="fas fa-dice"></i>
              </a>
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "WWN.details.wildernessAppearing"}}</label>
            <div class="form-fields">
              <input type="text" name="system.details.appearing.w" value="{{system.details.appearing.w}}" />
              <a data-action="rollAppearing" data-which="w" title="{{localize 'WWN.details.wildernessAppearing'}}">
                <i class="fas fa-dice"></i>
              </a>
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "WWN.details.treasure"}}</label>
            <div class="form-fields">
              <input type="text" name="system.details.treasure.type" value="{{system.details.treasure.type}}" />
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "WWN.details.treasureTable"}}</label>
            <div class="form-fields">
              <input type="text" name="system.details.treasure.table" value="{{system.details.treasure.table}}"
                placeholder="{{localize 'WWN.details.treasureTableTextHint'}}" />
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "WWN.details.instinct"}}</label>
            <div class="form-fields wwn-npc-instinct-table-link">
              {{#if instinctTableLink}}{{{instinctTableLink}}}{{else}}
              <span class="powers-muted">{{localize "WWN.details.instinctTableHint"}}</span>
              {{/if}}
            </div>
          </div>
          {{#if showAlignment}}
          <div class="form-group">
            <label>{{localize "WWN.details.alignment"}}</label>
            <div class="form-fields">
              <input type="text" name="system.details.alignment" value="{{system.details.alignment}}" />
              <a data-action="rollReaction" title="{{localize 'WWN.roll.reaction'}}"><i class="fas fa-dice"></i></a>
            </div>
          </div>
          {{/if}}
        </div>
      </div>

      <div class="wwn-form-column">
        <div class="wwn-form-panel">
          <div class="wwn-section-header">{{localize "WWN.category.config"}}</div>
          <div class="wwn-form-panel-fields">
            <div class="form-group">
              <label>{{localize "WWN.Initiative"}}</label>
              <div class="form-fields">
                <input type="number" name="system.combat.initMod" value="{{system.combat.initMod}}" data-dtype="Number" />
              </div>
            </div>
            <div class="form-group">
              <label title="{{localize 'WWN.Npc.DamageBonusHint'}}">{{localize "WWN.Npc.DamageBonus"}}</label>
              <div class="form-fields">
                <input type="number" name="system.combat.damageBonus" value="{{system.combat.damageBonus}}"
                  data-dtype="Number" />
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "WWN.DamageBonusHalfLevel"}}</label>
              <div class="form-fields">
                <input type="checkbox" name="system.combat.damageBonusHalfLevel"
                  {{checked system.combat.damageBonusHalfLevel}} data-dtype="Boolean" />
              </div>
            </div>
            <div class="form-group">
              <label title="{{localize 'WWN.Npc.AllWeaponsShockAnyAcHint'}}">{{localize "WWN.Npc.AllWeaponsShockAnyAc"}}</label>
              <div class="form-fields">
                <input type="checkbox" name="system.combat.allWeaponsShockAnyAc"
                  {{checked system.combat.allWeaponsShockAnyAc}} data-dtype="Boolean" />
              </div>
            </div>
            {{#if separateRangedAC}}
            <div class="form-group">
              <label>{{localize "WWN.ArmorClass"}} ({{localize "WWN.Missile"}})</label>
              <div class="form-fields">
                <input type="number" name="system.combat.acManual.ranged" value="{{system.combat.acManual.ranged}}"
                  data-dtype="Number" />
              </div>
            </div>
            {{/if}}
          </div>
        </div>

        <div class="wwn-form-panel">
          <div class="wwn-section-header">{{localize "WWN.Effects.SaveModifiers"}}</div>
          <div class="wwn-form-panel-fields">
            <div class="form-group">
              <label>{{localize "WWN.saves.evasion"}}</label>
              <div class="form-fields">
                <input type="number" name="system.saveMods.evasion" value="{{system.saveMods.evasion}}" data-dtype="Number" />
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "WWN.saves.mental"}}</label>
              <div class="form-fields">
                <input type="number" name="system.saveMods.mental" value="{{system.saveMods.mental}}" data-dtype="Number" />
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "WWN.saves.physical"}}</label>
              <div class="form-fields">
                <input type="number" name="system.saveMods.physical" value="{{system.saveMods.physical}}"
                  data-dtype="Number" />
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "WWN.saves.luck"}}</label>
              <div class="form-fields">
                <input type="number" name="system.saveMods.luck" value="{{system.saveMods.luck}}" data-dtype="Number" />
              </div>
            </div>
            <div class="form-group">
              <label title="{{localize 'WWN.Effects.SaveBaseMod'}}">{{localize "WWN.Effects.SaveBaseMod"}}</label>
              <div class="form-fields">
                <input type="number" name="system.saveMods.base" value="{{system.saveMods.base}}" data-dtype="Number" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="hint">{{localize "WWN.NpcConfigHint"}}</p>

    <div class="wwn-form-panel">
      <div class="wwn-section-header">{{localize "WWN.category.notes"}}</div>
      {{> wwnSheetEditor name="system.biography" value=source.system.biography
        documentUuid=actor.uuid enriched=enrichedBiography fill=true}}
    </div>
  </div>
</section>
