{{!-- NPC Main: vitals + combat chips + Attacks | Favorites. --}}
<section class="tab attributes-tab flexcol {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="wwn-npc-main">

    <div class="wwn-npc-band wwn-npc-band--vitals">
      <div class="wwn-npc-combat-stack">
        <div class="wwn-form-panel">
          <div class="wwn-npc-stat-row">
            <label class="wwn-save-cell" title="{{localize 'WWN.AB'}}">
              <span class="wwn-section-header">{{localize "WWN.Sheet.AttackBonusShort"}}</span>
              <input class="wwn-save-value" type="number" name="system.combat.ab" value="{{system.combat.ab}}"
                data-dtype="Number" />
            </label>
            <label class="wwn-save-cell" title="{{localize 'WWN.ArmorClass'}}">
              <span class="wwn-section-header">{{localize "WWN.ArmorClassShort"}}</span>
              <input class="wwn-save-value" name="system.combat.acManual.melee" type="number"
                value="{{system.combat.acManual.melee}}" data-dtype="Number" placeholder="10" />
            </label>
            <label class="wwn-save-cell" title="{{localize 'WWN.movement.base'}}">
              <span class="wwn-section-header">{{localize "WWN.movement.monsterShort"}}</span>
              <input class="wwn-save-value" name="system.movement.base.value" type="number"
                value="{{system.movement.base.value}}" placeholder="30" data-dtype="Number" />
            </label>
          </div>
        </div>
        <div class="wwn-form-panel">
          <div class="wwn-npc-stat-row">
            <label class="wwn-save-cell" title="{{localize 'WWN.skill'}}">
              <a class="wwn-section-header wwn-rollable" data-action="rollNpcSkill">{{localize "WWN.skill"}}</a>
              <input class="wwn-save-value" name="system.skill" type="number" value="{{system.skill}}"
                placeholder="0" data-dtype="Number" />
            </label>
            <label class="wwn-save-cell" title="{{localize 'WWN.details.morale'}}">
              <a class="wwn-section-header wwn-rollable" data-action="rollMorale">{{localize "WWN.details.morale"}}</a>
              <input class="wwn-save-value" name="system.details.morale" type="number"
                value="{{system.details.morale}}" placeholder="0" data-dtype="Number" />
            </label>
            <label class="wwn-save-cell" title="{{localize 'WWN.details.instinct'}}">
              <a class="wwn-section-header wwn-rollable" data-action="rollInstinct">{{localize "WWN.details.instinct"}}</a>
              <input class="wwn-save-value" name="system.details.instinct" type="number"
                value="{{system.details.instinct}}" placeholder="0" data-dtype="Number" />
            </label>
            {{#if useTrauma}}
            <label class="wwn-save-cell" title="{{localize 'WWN.TraumaTargetLong'}}">
              <span class="wwn-section-header">{{localize "WWN.TraumaTargetMedium"}}</span>
              <input class="wwn-save-value" type="number" name="system.trauma.value" value="{{system.trauma.value}}"
                data-dtype="Number" placeholder="6" />
            </label>
            {{/if}}
          </div>
        </div>
      </div>
      <div class="wwn-npc-saves wwn-form-panel">
        <div class="wwn-save-grid">
          {{#each saves as |save|}}
          <a class="wwn-rollable wwn-save-cell" data-action="rollSave" data-save="{{save.id}}"
            title="{{localize save.label}}">
            <span class="wwn-section-header">{{localize save.label}}</span>
            <span class="wwn-save-value">{{save.value}}</span>
          </a>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="wwn-npc-main-lists">
      <div class="wwn-npc-attacks">
        {{#> wwnCollapsibleSection sectionId="npc.attacks"
          label=(localize "WWN.category.attacksAndEquipment")
          count=(add attackPatterns.length otherItems.length)
          collapsed=(lookup @root.collapsed "npc.attacks")
          searchType="weapon" createType="weapon" showResetWeaponCounters=true}}
        <div class="wwn-data-table">
          <div class="item-titles wwn-col-header flexrow">
            <div class="item-name">{{localize "WWN.Sheet.Name"}}</div>
            <div class="field-short" title="{{localize 'WWN.items.pattern'}}">Pat</div>
            <div class="field-long" title="{{localize 'WWN.items.roundAttacks'}}">Atk</div>
            <div class="item-controls"></div>
          </div>
          <ol class="item-list">
            {{#each attackPatterns as |item|}}
            <li class="item-entry">
              <div class="item flexrow" data-item-id="{{item.id}}">
                <div class="item-name item-rollable flexrow" data-action="showItem">
                  <img class="item-image" src="{{item.img}}" alt="" data-action="rollItem" />
                  <h4 title="{{item.name}}">{{item.name}}</h4>
                </div>
                <div class="field-short">
                  <a class="item-pattern" data-action="cyclePattern"
                    title="{{localize (lookup @root.config.colors item.system.pattern)}}">
                    <i class="fas fa-square" style="color: {{item.system.pattern}};"></i>
                  </a>
                </div>
                <div class="field-long counter flexrow">
                  <input type="text" value="{{item.system.counter.value}}" data-dtype="Number" placeholder="0"
                    data-item-field="system.counter.value" title="{{localize 'WWN.items.roundAttacks'}}" />
                  /
                  <input type="text" value="{{item.system.counter.max}}" data-item-field="system.counter.max"
                    data-dtype="Number" placeholder="0" title="{{localize 'WWN.items.roundAttacksMax'}}" />
                </div>
                <div class="item-controls">
                  {{#if ../owner}}
                  {{> wwnItemControls favoritable=@root.favoritesEnabled favorited=item.favorited}}
                  {{/if}}
                </div>
              </div>
            </li>
            {{/each}}
          </ol>
        </div>
        <div class="wwn-npc-gear wwn-data-table">
          <div class="item-titles wwn-col-header flexrow">
            <div class="item-name">{{localize "WWN.category.equipment"}}</div>
            <div class="item-controls">
              <a class="item-control" data-action="itemSearch" data-type="item" title="{{localize 'WWN.Search'}}">
                <i class="fa fa-search"></i>
              </a>
              <a class="item-control" data-action="createItem" data-type="item" title="{{localize 'WWN.Sheet.CreateItem'}}">
                <i class="fa fa-plus"></i>
              </a>
            </div>
          </div>
          <ol class="item-list">
            {{#each otherItems as |item|}}
            <li class="item-entry">
              <div class="item flexrow" data-item-id="{{item.id}}">
                <div class="item-name item-rollable flexrow" data-action="showItem">
                  <img class="item-image" src="{{item.img}}" alt="" data-action="rollItem" />
                  <h4 title="{{item.name}}">{{item.name}}</h4>
                </div>
                <div class="item-controls">
                  {{#if ../owner}}
                  {{> wwnItemControls favoritable=@root.favoritesEnabled favorited=item.favorited}}
                  {{/if}}
                </div>
              </div>
            </li>
            {{/each}}
          </ol>
        </div>
        {{/wwnCollapsibleSection}}
      </div>

      {{> wwnFavoritesDock}}
    </div>

  </div>
</section>
