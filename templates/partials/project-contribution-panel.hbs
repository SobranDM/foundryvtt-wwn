{{!-- Project contribution panel: one row per contributing actor (PC or NPC).
      Kept deliberately compact — most projects have a handful of
      contributors, not an inventory-sized list — so the row only shows
      Name / Influence / Dominion (or Silver, for WWN) / controls; Note is
      tucked behind a per-row expand toggle instead of its own column. --}}
{{#> wwnCollapsibleSection sectionId="project.contributions"
  label=(localize "WWN.project.contributions")
  count=contributions.length
  collapsed=collapsed}}
<div class="wwn-data-table wwn-project-contributions">
  <div class="wwn-project-contribution-actions flexrow">
    <a class="item-control" data-action="contributionCreate" title="{{localize 'WWN.project.addContribution'}}">
      <i class="fas fa-plus"></i>
    </a>
  </div>
  <div class="item-titles wwn-col-header flexrow">
    <div class="item-name">{{localize "WWN.project.contributor"}}</div>
    {{#if isGodbound}}
    <div class="project-field" title="{{localize 'WWN.project.influenceCommitted'}}">{{localize "WWN.project.influenceCommitted"}}</div>
    <div class="project-field" title="{{localize 'WWN.project.dominionSpent'}}">{{localize "WWN.project.dominionSpent"}}</div>
    {{/if}}
    {{#if isWwn}}
    <div class="project-field" title="{{localize 'WWN.project.resourceContributed'}}">{{localize "WWN.project.resourceContributed"}}</div>
    {{/if}}
    <div class="item-controls"></div>
  </div>
  <ol class="item-list">
    {{#each contributions as |row|}}
    <li class="item-entry">
      <div class="item flexrow" data-item-id="{{row.item.id}}">
        <div class="item-name flexrow project-contributor-name">
          <img class="item-image" src="{{row.item.img}}" alt="" />
          <h4 title="{{#if row.broken}}{{localize 'WWN.project.brokenLink'}}: {{row.item.name}}{{else}}{{row.item.name}}{{/if}}">
            {{row.item.name}}
            {{#if row.broken}}<i class="fas fa-unlink" style="color: var(--wwn-danger, #a33);"></i>{{/if}}
          </h4>
        </div>
        {{#if @root.isGodbound}}
        <div class="project-field">
          <input type="number" step="1" data-dtype="Number" value="{{row.item.system.influenceCommitted}}"
            data-item-field="system.influenceCommitted" {{#unless @root.editable}}disabled{{/unless}} />
        </div>
        <div class="project-field">
          <input type="number" step="1" data-dtype="Number" value="{{row.item.system.dominionSpent}}"
            data-item-field="system.dominionSpent" {{#unless @root.editable}}disabled{{/unless}} />
        </div>
        {{/if}}
        {{#if @root.isWwn}}
        <div class="project-field">
          <input type="number" step="1" data-dtype="Number" value="{{row.item.system.resourceContributed}}"
            data-item-field="system.resourceContributed" {{#unless @root.editable}}disabled{{/unless}} />
        </div>
        {{/if}}
        <div class="item-controls">
          <a class="item-control project-note-toggle{{#unless row.item.system.note}} item-off{{/unless}}"
            data-action="toggleContributionNote"
            title="{{#if row.item.system.note}}{{row.item.system.note}}{{else}}{{localize 'WWN.project.note'}}{{/if}}">
            <i class="fas fa-note-sticky"></i>
          </a>
          {{#if row.linkedActor}}
          <a class="item-control" data-action="openContributionActor" title="{{localize 'WWN.project.openActor'}}">
            <i class="fas fa-external-link-alt"></i>
          </a>
          <a class="item-control" data-action="unlinkContribution" title="{{localize 'WWN.project.unlinkActor'}}">
            <i class="fas fa-unlink"></i>
          </a>
          {{/if}}
          <a class="item-control" data-action="deleteItem" title="{{localize 'WWN.Delete'}}"><i class="fas fa-trash"></i></a>
        </div>
      </div>
      <div class="wwn-project-contribution-note-row" hidden>
        <label>{{localize "WWN.project.note"}}</label>
        <input type="text" value="{{row.item.system.note}}" data-item-field="system.note"
          placeholder="{{localize 'WWN.project.noteEmpty'}}" {{#unless @root.editable}}disabled{{/unless}} />
      </div>
    </li>
    {{/each}}
    {{#unless contributions.length}}
    <li class="item-entry wwn-project-contribution-empty">
      <p class="wwn-field-hint">{{localize "WWN.project.linkActor"}}</p>
    </li>
    {{/unless}}
  </ol>
</div>
{{/wwnCollapsibleSection}}
