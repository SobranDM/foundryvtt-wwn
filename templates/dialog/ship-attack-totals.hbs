<form class="wwn flexcol">
  <p>{{localize "WWN.Starship.EnterAttackTotals"}}</p>
  <div class="form-group">
    <label>{{localize "WWN.Starship.AttackTotal"}}</label>
    <input type="number" name="attack" value="{{attack}}" data-dtype="Number" />
  </div>
  <div class="form-group">
    <label>{{localize "WWN.Starship.DamageTotal"}}</label>
    <input type="number" name="damage" value="{{damage}}" data-dtype="Number" />
  </div>
</form>
